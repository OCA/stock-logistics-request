<odoo>
    <record id="stock_request_type_kanban" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="count_sr_todo" />
                <field name="count_sr_open" />
                <field name="count_sr_late" />
            </field>
            <!-- Kanban menu: "All" entry -->
            <xpath
                expr="//div[@role='menuitem']/a[@name='get_stock_picking_action_picking_type']"
                position="replace"
            >
                <a
                    t-if="record.code.raw_value == 'stock_request_order'"
                    name="%(action_picking_dashboard)d"
                    type="action"
                >All</a>
                <a
                    t-else=""
                    name="get_stock_picking_action_picking_type"
                    type="object"
                >All</a>
            </xpath>
            <!-- Kanban menu: "Ready" entry -->
            <xpath
                expr="//div[@role='menuitem']/a[@name='get_action_picking_tree_ready']"
                position="replace"
            >
                <a
                    t-if="record.code.raw_value == 'stock_request_order'"
                    name="%(action_picking_dashboard)d"
                    type="action"
                    context="{'search_default_todo': 1}"
                >To Do</a>
                <a
                    t-else=""
                    name="get_action_picking_tree_ready"
                    type="object"
                >Ready</a>
            </xpath>
            <!-- Kanban menu: "Waiting" entry -->
            <xpath
                expr="//div[@role='menuitem']/a[@name='get_action_picking_tree_waiting']"
                position="replace"
            >
                <a
                    t-if="record.code.raw_value == 'stock_request_order'"
                    name="%(action_picking_dashboard)d"
                    type="action"
                    context="{'search_default_open': 1}"
                >In Progress</a>
                <a
                    t-else=""
                    name="get_action_picking_tree_waiting"
                    type="object"
                >Waiting</a>
            </xpath>
            <!-- Kanban menu: "Reporting" entry -->
            <xpath
                expr="//div[@role='menuitem']/a[@name='get_action_picking_type_moves_analysis']"
                position="replace"
            >
                <a
                    t-if="record.code.raw_value == 'stock_request_order'"
                    name="%(action_picking_dashboard)d"
                    type="action"
                    context="{'search_default_done': 1}"
                >Done</a>
                <a
                    t-else=""
                    name="get_action_picking_type_moves_analysis"
                    type="object"
                >Reporting</a>
            </xpath>
            <!-- Kanban menu: "New" entry -->
            <xpath expr="//div[@name='kanban_menu_section']/h5" position="replace">
                <h5 role="menuitem" class="o_kanban_card_manage_title">
                    <a
                        t-if="record.code.raw_value == 'stock_request_order'"
                        name="%(action_stock_request_order_form)d"
                        type="action"
                    >New</a>
                    <a
                        t-else=""
                        name="%(stock.action_picking_form)d"
                        type="action"
                    >New</a>
                </h5>
            </xpath>
            <!-- Card: title link -->
            <xpath
                expr="//div[@name='stock_picking']/a[@name='get_stock_picking_action_picking_type']"
                position="replace"
            >
                <a
                    t-if="!selection_mode and record.code.raw_value == 'stock_request_order'"
                    type="object"
                    name="get_stock_request_order_picking_type_action"
                >
                    <field class="fw-bold fs-4" name="name" />
                </a>
                <a
                    t-if="!selection_mode and record.code.raw_value != 'stock_request_order'"
                    type="object"
                    name="get_stock_picking_action_picking_type"
                >
                    <field class="fw-bold fs-4" name="name" />
                </a>
            </xpath>
            <!-- Card: main button -->
            <xpath
                expr="//button[@name='get_action_picking_tree_ready']"
                position="replace"
            >
                <button
                    t-if="record.code.raw_value == 'stock_request_order'"
                    class="btn btn-primary"
                    name="%(action_picking_dashboard)d"
                    type="action"
                    context="{'search_default_todo': 1}"
                >
                    <span t-if="record.count_sr_todo.raw_value > 0">
                        <field name="count_sr_todo" /> To Process
                    </span>
                    <span t-else="">Open</span>
                </button>
                <button
                    t-if="record.code.raw_value != 'stock_request_order'"
                    class="btn btn-primary"
                    name="get_action_picking_tree_ready"
                    type="object"
                >
                    <span t-if="record.count_picking_ready.raw_value > 0">
                        <field name="count_picking_ready" />
                        <t t-if="record.code.raw_value === 'incoming'"> To Receive</t>
                        <t
                            t-elif="record.code.raw_value === 'outgoing'"
                            name="outgoing_label"
                        > To Deliver</t>
                        <t t-else=""> To Process</t>
                    </span>
                    <span t-else="">Open</span>
                </button>
            </xpath>
            <!-- Card: "Waiting" / "In Progress" row -->
            <xpath
                expr="//div[@t-if='record.count_picking_waiting.raw_value > 0']"
                position="replace"
            >
                <div
                    t-if="record.code.raw_value == 'stock_request_order' and record.count_sr_open.raw_value > 0"
                    class="row"
                >
                    <a
                        class="col-8 offset-4 pe-0 text-truncate"
                        name="%(action_picking_dashboard)d"
                        type="action"
                        context="{'search_default_open': 1}"
                    >
                        <div class="row">
                            <span class="col-6">In Progress</span>
                            <field class="col-2 text-end" name="count_sr_open" />
                        </div>
                    </a>
                </div>
                <div
                    t-if="record.code.raw_value != 'stock_request_order' and record.count_picking_waiting.raw_value > 0"
                    class="row"
                >
                    <a
                        class="col-8 offset-4 pe-0 text-truncate"
                        name="get_action_picking_tree_waiting"
                        type="object"
                    >
                        <div class="row">
                            <span class="col-6">Waiting</span>
                            <field
                                class="col-2 text-end"
                                name="count_picking_waiting"
                            />
                        </div>
                    </a>
                </div>
            </xpath>
            <!-- Card: "Late" row -->
            <xpath
                expr="//div[@t-if='record.count_picking_late.raw_value > 0']"
                position="replace"
            >
                <div
                    t-if="record.code.raw_value == 'stock_request_order' and record.count_sr_late.raw_value > 0"
                    class="row"
                >
                    <a
                        class="col-8 offset-4 pe-0 text-truncate"
                        name="%(action_picking_dashboard)d"
                        type="action"
                        context="{'search_default_late': 1}"
                    >
                        <div class="row">
                            <span class="col-6">Late</span>
                            <field class="col-2 text-end" name="count_sr_late" />
                        </div>
                    </a>
                </div>
                <div
                    t-if="record.code.raw_value != 'stock_request_order' and record.count_picking_late.raw_value > 0"
                    class="row"
                >
                    <a
                        class="col-8 offset-4 pe-0 text-truncate"
                        name="get_action_picking_tree_late"
                        type="object"
                    >
                        <div class="row">
                            <span class="col-6">Late</span>
                            <field class="col-2 text-end" name="count_picking_late" />
                        </div>
                    </a>
                </div>
            </xpath>
            <!-- Card: hide "Back Orders" row for stock request order types -->
            <xpath
                expr="//div[@name='picking_type_backorder_count']"
                position="attributes"
            >
                <attribute
                    name="t-if"
                >record.code.raw_value != 'stock_request_order' and record.count_picking_backorders.raw_value > 0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
