<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.stock_request_separate_picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_request.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='stock_request']" position="inside">
                <setting
                    help="If checked, separate one picking per one Stock Request / Stock Request Order."
                    class="text-muted"
                >
                    <field
                        name="stock_request_allow_separate_picking"
                        string="Allow Separate Picking"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
