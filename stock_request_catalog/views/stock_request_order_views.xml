<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_request_order_form" model="ir.ui.view">
        <field name="name">stock.request.order.form.catalog</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stock_request_ids']/list" position="inside">
                <control>
                    <create name="add_product_control" string="Add a product" />
                    <button
                        string="Catalog"
                        name="action_add_from_catalog"
                        type="object"
                        class="px-4 btn-link"
                        context="{'order_id': parent.id}"
                    />
                </control>
            </xpath>
        </field>
    </record>
</odoo>
